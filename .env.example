# Token do bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# ID da aplicação (Developer Portal > General Information > Application ID)
CLIENT_ID=

# (Opcional) ID do servidor de testes. Com ele, os comandos são registrados
# instantaneamente só nesse servidor. Sem ele, o registro é global (demora até 1h).
GUILD_ID=

# (Opcional) ID da categoria onde os tickets serão criados
TICKET_CATEGORY_ID=

# (Opcional) ID do cargo de suporte que poderá ver e fechar os tickets
TICKET_SUPPORT_ROLE_ID=
